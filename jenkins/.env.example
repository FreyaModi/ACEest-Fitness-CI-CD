# Copy to .env and fill in. .env is git-ignored - never commit real passwords.
JENKINS_ADMIN_ID=admin
JENKINS_ADMIN_PASSWORD=change-me
# Public HTTPS URL of the GitHub repository to build.
GITHUB_REPO_URL=https://github.com/<your-user>/aceest-fitness-devops.git
GITHUB_BRANCH=main
JENKINS_URL=http://localhost:8080/
# Host port for the Jenkins UI (used by docker-compose.yml).
JENKINS_PORT=8080
